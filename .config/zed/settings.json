// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "cli_default_open_behavior": "existing_window",
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "theme": "Ayu Dark",
  "language_models": {
    "openai_compatible": {}
  },
  "diagnostics": {
    "button": true
  },
  "toolbar": {
    "agent_review": true,
    "selections_menu": false
  },
  "notification_panel": {
    "default_width": 300.0,
    "button": false
  },
  "debugger": {
    "button": false,
    "dock": "right"
  },
  "collaboration_panel": {
    "default_width": 300.0,
    "button": false,
    "dock": "right"
  },
  "outline_panel": {
    "folder_icons": true,
    "file_icons": true,
    "git_status": true,
    "button": false,
    "dock": "right"
  },
  "git_panel": {
    "default_width": 300.0,
    "button": false,
    "dock": "right"
  },
  "status_bar": {
    "cursor_position_button": true,
    "active_language_button": true
  },
  "tabs": {
    "file_icons": false,
    "git_status": false
  },
  "title_bar": {
    "show_user_picture": false,
    "show_sign_in": false,
    "show_menus": false,
    "show_onboarding_banner": true,
    "show_project_items": true,
    "show_branch_name": true
  },
  "vim_mode": true,
  "terminal": {
    "button": false,
    "dock": "bottom",
    "font_size": 14.0,
    "option_as_meta": true,
    "max_scroll_history_lines": 10000
  },
  "project_panel": {
    "default_width": 300.0,
    "hide_gitignore": false,
    "entry_spacing": "comfortable",
    "indent_size": 20.0,
    "sticky_scroll": true,
    "indent_guides": {
      "show": "always"
    },
    "hide_hidden": false,
    "hide_root": false,
    "dock": "right",
    "button": false,
    "auto_reveal_entries": false,
    "auto_fold_dirs": true
  },
  "base_keymap": "VSCode",
  "tab_bar": {
    "show": false,
    "show_tab_bar_buttons": false
  },
  "search": {
    "button": false,
    "include_ignored": true
  },
  "relative_line_numbers": "enabled",
  "sticky_scroll": {
    "enabled": false
  },
  "vertical_scroll_margin": 1.0,
  "gutter": {
    "runnables": true,
    "line_numbers": true
  },
  "minimap": {
    "show": "never"
  },
  "autosave": {
    "after_delay": {
      "milliseconds": 1000
    }
  },
  "lsp": {
    "basedpyright": {
      "binary": {
        "path": "/Users/jay/Library/Python/3.9/bin/basedpyright-langserver",
        "arguments": ["--stdio"]
      },
      "initialization_options": {
        "settings": {
          "pythonPath": "/Library/Developer/CommandLineTools/usr/bin/python3"
        }
      }
    }
  },
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "show_edit_predictions": true,
  "ensure_final_newline_on_save": true,
  "ui_font_size": 16,
  "buffer_font_size": 14.0
}
