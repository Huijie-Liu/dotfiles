# File management
abbr --add ls 'eza --color=always --long --git --no-filesize --icons=always --no-time --no-user --no-permissions'
abbr --add l 'eza -la --color=always --long --git --no-filesize --icons=always --no-time --no-user --no-permissions'
abbr --add md 'mkdir -p'
abbr --add rd rmdir

# Navigation
abbr --add cd z

# Git
abbr --add lg lazygit

# System
abbr --add ff fastfetch
abbr --add c clear
abbr --add x exit

# Tmux
abbr --add ta 'tmux attach'
abbr --add tl 'tmux list-session'
abbr --add ts 'tmux new-session'
